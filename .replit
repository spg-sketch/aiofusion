modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "release-candidate"

[[workflows.workflow]]
name = "release-candidate"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "RELEASE_ENVIRONMENT=staging pnpm run release:check"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test && pnpm --filter @workspace/aio-fusion run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run typecheck"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[userenv]

[userenv.shared]
RESEND_FROM = "AIO Fusion Alerts <info@aiofusion.ai>"

[userenv.production]
PLATFORM_AUTO_APPROVE_ADMIN_EMAILS = "spg@bluhalo.com"
CANONICAL_DOMAIN = "staging.aiofusion.ai"
DEPLOYMENT_ENV = "staging"
PRODUCTION_DB_IDENTIFIERS = "postgresql://neondb_owner:npg_wKxOHs3BrbI0@ep-soft-wave-a57kzjbb.us-east-2.aws.neon.tech/neondb?sslmode=require"
STAGING_SIGNUP_TEST_EMAIL = "hello@vibestudio.agency"
FAIR_USAGE_ENFORCEMENT_ENABLED = "true"

[userenv.development]
STAGING_SIGNUP_TEST_EMAIL = "hello@vibestudio.agency"

[nix]
channel = "stable-25_05"
packages = ["glib", "nss", "nspr", "dbus", "atk", "at-spi2-atk", "cups", "expat", "libdrm", "mesa", "xorg.libxcb", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "libxkbcommon", "pango", "cairo", "alsa-lib", "libgbm"]

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 18664
externalPort = 3000

[[ports]]
localPort = 24362
externalPort = 80

[objectStorage]
defaultBucketID = "replit-objstore-802dbaf4-ecde-4956-b539-7205f1d4aed4"
